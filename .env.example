# Database (Neon Serverless Postgres connection string)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# Telegram Bot
TELEGRAM_BOT_TOKEN="0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_WEBHOOK_SECRET="your_telegram_webhook_secret_key_here"

# Cron Secret for Vercel Cron
CRON_SECRET="your_cron_secret_key_here"

# Admin Authentication Secret
JWT_SECRET="your_jwt_auth_secret_key_very_long_and_random"

# Business Settings
WORK_END_HOUR="18:00"
APP_TIMEZONE="Asia/Tehran"
APP_URL="https://your-domain.com"
